{
  "name": "daily-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rls": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run -c vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local scripts/seed-content.ts",
    "typecheck": "tsc --noEmit",
    "accounts": "node --env-file=.env.local scripts/accounts.ts",
    "content:wordlists": "node --env-file=.env.local scripts/import-wordlists.ts",
    "content:dictionary": "node --env-file=.env.local scripts/build-dictionary.ts",
    "content:topic-vocab": "node --env-file=.env.local scripts/generate-topic-vocab.ts",
    "content:items": "node --env-file=.env.local scripts/generate-items.ts",
    "content:copy": "node scripts/copy-content.ts --from .env.local --to .env.production.local"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "openai": "^7.31.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "wink-lemmatizer": "^3.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
