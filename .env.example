NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
OPENAI_API_KEY=
# Model IDs live in env so they can change without code edits
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_GRADER=gpt-5
# Optional price overrides (USD per 1M tokens, "input,output") for unknown model IDs
# OPENAI_PRICE_FAST=0.20,1.20
# OPENAI_PRICE_GRADER=2,12
CRON_SECRET=
AI_DAILY_CALL_LIMIT=80
AI_MONTHLY_BUDGET_USD=5

# The only three accounts (created by `npm run accounts`; never commit real passwords)
ACCOUNT_ADMIN_EMAIL=admin@dailyenglish.app
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_PARENT_EMAIL=parent@dailyenglish.app
ACCOUNT_PARENT_PASSWORD=
ACCOUNT_LEARNER_EMAIL=hung@dailyenglish.app
ACCOUNT_LEARNER_PASSWORD=
